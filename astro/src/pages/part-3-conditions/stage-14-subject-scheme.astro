      <CodeBlock code={"--- a/audacity-guide.ditamap\n+++ b/audacity-guide.ditamap\n@@ -21,6 +21,7 @@\n     </keywords>\n   </topicmeta>\n \n+  <mapref href=\"subject-scheme.ditamap\" type=\"subjectScheme\"/>\n   <mapref href=\"keydefs-product.ditamap\"/>\n   <mapref href=\"keydefs-glossary.ditamap\"/>\n   <keydef keys=\"start-here\" href=\"topics/what-is-audacity.dita\"/>"} lang="diff" title="audacity-guide.ditamap" />
