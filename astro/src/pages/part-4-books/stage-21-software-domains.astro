      <Card class="p-4 hover:border-foreground/20 transition-colors">
      <CardContent class="p-0">
      <a href="https://github.com/dogsbay/dogsbay-xml-dita-tutorial/compare/tutorial/20-hazards-and-safety...tutorial/21-software-domains" class="[text-decoration:none] text-foreground">
      <Icon name="github" class="size-5 mb-2 text-muted-foreground" />
